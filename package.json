  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sjothr-mcp": "src/bridge.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/bridge.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Djangode/sjothr-mcp.git"
  },
  "homepage": "https://sjothr.xyz",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tokenization",
    "fundraising",
